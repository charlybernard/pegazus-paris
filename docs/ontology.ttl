                             <http://purl.org/dc/terms/creator> _:genid1 ;
                             <http://purl.org/dc/terms/description> "Ontologie PeGazUs pour représenter l'évolution des entités géographiques"@fr ,
                                                                    "PeGazUs ontology to represent the evolution of geographical entities"@en ;
                             <http://purl.org/dc/terms/issued> "2023-10-30"^^xsd:date ;
                             <http://purl.org/dc/terms/modified> "2026-08-01"^^xsd:date ;
                             <http://purl.org/dc/terms/publisher> <http://fr.dbpedia.org/resource/Institut_national_de_l%27information_g%C3%A9ographique_et_foresti%C3%A8re> ;
                             <http://purl.org/dc/terms/rights> "Copyright 2025, IGN" ;
                             <http://purl.org/dc/terms/title> "Ontologie PeGazUs"@fr ,
                                                              "PeGazUs ontology"@en ;
                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "peg" ;
                             <http://purl.org/vocab/vann/preferredNamespaceUri> <https://w3id.org/PeGazUs#> ;
                             owl:versionInfo "Version 0.2 - 2026-08-01" .

_:genid1 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://www.w3.org/ns/org#hasMembership> _:genid2 ;
          <http://xmlns.com/foaf/0.1/family_name> "Bernard" ;
          <http://xmlns.com/foaf/0.1/firstName> "Charly" ;
          <http://xmlns.com/foaf/0.1/mbox> <mailto:charly.bernard@ign.fr> ;
          <http://xmlns.com/foaf/0.1/name> "Charly Bernard" ;
          <http://xmlns.com/foaf/0.1/workInfoHomepage> <https://www.umr-lastig.fr/charly-bernard/> .

_:genid2 rdf:type <http://www.w3.org/ns/org#Membership> ;
          <http://www.w3.org/ns/org#memberDuring> _:genid3 ;
          <http://www.w3.org/ns/org#organization> <http://www.ign.fr/> ,
                                                  <http://www.umr-lastig.fr/> ;
          <http://www.w3.org/ns/org#role> _:genid5 .

_:genid3 rdf:type <http://www.w3.org/2006/time#Interval> ;
          <http://www.w3.org/2006/time#hasBeginning> _:genid4 .

_:genid5 rdf:type <http://www.w3.org/ns/org#Role> ;
          rdfs:label "Doctorant"@fr ,
                     "PhD Student"@en .

_:genid4 rdf:type <http://www.w3.org/2006/time#Instant> ;
          <http://www.w3.org/2006/time#inXSDDateTimeStamp> "2019-10-15"^^xsd:dateTimeStamp .

