dc:issued a owl:AnnotationProperty .
dc:modified a owl:AnnotationProperty .
dc:publisher a owl:AnnotationProperty .
dc:rights a owl:AnnotationProperty .
dc:title a owl:AnnotationProperty .
ns0:preferredNamespacePrefix a owl:AnnotationProperty .
ns0:preferredNamespaceUri a owl:AnnotationProperty .
rdfs:comment
  a owl:AnnotationProperty ;
  rdfs:comment ""@en ;
  rdfs:isDefinedBy prov:, <http://www.w3.org/ns/prov-o#> .

owl:maxQualifiedCardinality a owl:AnnotationProperty .
skos:altLabel a owl:AnnotationProperty .
skos:broader a owl:AnnotationProperty .
skos:changeNote a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .
skos:example a owl:AnnotationProperty .
skos:inScheme a owl:AnnotationProperty .
skos:note a owl:AnnotationProperty .
skos:prefLabel a owl:AnnotationProperty .
skos:scopeNote a owl:AnnotationProperty .
time:hasBeginning a owl:AnnotationProperty .
time:inXSDDateTimeStamp a owl:AnnotationProperty .
org:hasMembership a owl:AnnotationProperty .
org:memberDuring a owl:AnnotationProperty .
org:organization a owl:AnnotationProperty .
org:role a owl:AnnotationProperty .
prov:category a owl:AnnotationProperty .
prov:component a owl:AnnotationProperty .
prov:constraints a owl:AnnotationProperty .
prov:definition a owl:AnnotationProperty .
prov:dm a owl:AnnotationProperty .
prov:inverse a owl:AnnotationProperty .
prov:n a owl:AnnotationProperty .
prov:qualifiedForm a owl:AnnotationProperty .
foaf:family_name a owl:AnnotationProperty .
foaf:firstName a owl:AnnotationProperty .
foaf:mbox a owl:AnnotationProperty .
foaf:name a owl:AnnotationProperty .
foaf:workInfoHomepage a owl:AnnotationProperty .
xsd:date a rdfs:Datatype .
time:after
  a owl:ObjectProperty ;
  owl:inverseOf time:before ;
  rdfs:domain time:TemporalEntity ;
  rdfs:range time:TemporalEntity ;
  rdfs:comment "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es, "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en ;
  rdfs:label "after"@en, "después"@es ;
  skos:definition "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es, "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en .

time:before
  a owl:ObjectProperty, owl:TransitiveProperty ;
  rdfs:domain time:TemporalEntity ;
  rdfs:range time:TemporalEntity ;
  rdfs:comment "Asume una dirección en el tiempo. Si una entidad temporal T1 está antes que otra entidad temporal T2, entonces el final de T1 está antes que el principio de T2. Así, \"antes\" se puede considerar básica para instantes y derivada para intervalos."@es, "Gives directionality to time. If a temporal entity T1 is before another temporal entity T2, then the end of T1 is before the beginning of T2. Thus, \"before\" can be considered to be basic to instants and derived for intervals."@en ;
  rdfs:label "antes"@es, "before"@en ;
  skos:definition "Asume una dirección en el tiempo. Si una entidad temporal T1 está antes que otra entidad temporal T2, entonces el final de T1 está antes que el principio de T2. Así, \"antes\" se puede considerar básica para instantes y derivada para intervalos."@es, "Gives directionality to time. If a temporal entity T1 is before another temporal entity T2, then the end of T1 is before the beginning of T2. Thus, \"before\" can be considered to be basic to instants and derived for intervals."@en .

time:hasTRS
  a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
     time:GeneralDurationDescription
     time:TemporalPosition
   )
  ] ;
  rdfs:range time:TRS ;
  rdfs:comment "El sistema de referencia temporal utilizado por una posición temporal o descripción de extensión."@es, "The temporal reference system used by a temporal position or extent description. "@en ;
  rdfs:label "Temporal reference system used"@en, "sistema de referencia temporal utilizado"@es ;
  skos:definition "El sistema de referencia temporal utilizado por una posición temporal o descripción de extensión."@es, "The temporal reference system used by a temporal position or extent description. "@en .

time:intervalAfter
  a owl:ObjectProperty ;
  rdfs:subPropertyOf time:after, time:intervalDisjoint ;
  owl:inverseOf time:intervalBefore ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalAfter another proper interval T2, then the beginning of T1 is after the end of T2."@en, "Si un intervalo propio T1 es posterior a otro intervalo propio T2, entonces el principio de T1 está después que el final de T2." ;
  rdfs:label "interval after"@en, "intervalo posterior"@es ;
  skos:definition "If a proper interval T1 is intervalAfter another proper interval T2, then the beginning of T1 is after the end of T2."@en, "Si un intervalo propio T1 es posterior a otro intervalo propio T2, entonces el principio de T1 está después que el final de T2."@es .

time:intervalBefore
  a owl:ObjectProperty ;
  rdfs:subPropertyOf time:before, time:intervalDisjoint ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en, "Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2."@es ;
  rdfs:label "interval before"@en, "intervalo anterior"@es ;
  skos:definition "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en, "Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2."@es .

time:intervalContains
  a owl:ObjectProperty ;
  owl:inverseOf time:intervalDuring ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalContains another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is after the end of T2."@en, "Si un intervalo propio T1 contiene otro intervalo propio T2, entonces el principio de T1 está antes que el principio de T2, y el final de T1 está después del final de T2."@es ;
  rdfs:label "interval contains"@en, "intervalo contiene"@es ;
  skos:definition "If a proper interval T1 is intervalContains another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is after the end of T2."@en, "Si un intervalo propio T1 contiene otro intervalo propio T2, entonces el principio de T1 está antes que el principio de T2, y el final de T1 está después del final de T2."@es .

time:intervalDisjoint
  a owl:ObjectProperty ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalDisjoint another proper interval T2, then the beginning of T1 is after the end of T2, or the end of T1 is before the beginning of T2, i.e. the intervals do not overlap in any way, but their ordering relationship is not known."@en, "Si un intervalo propio T1 es disjunto con otro intervalo propio T2, entonces el principio de T1 está después del final de T2, o el final de T1 está antes que el principio de T2, es decir, los intervalos no se solapan de ninguna forma, aunque su relación de orden no se conozca."@es ;
  rdfs:label "interval disjoint"@en, "intervalo disjunto"@es ;
  skos:definition "If a proper interval T1 is intervalDisjoint another proper interval T2, then the beginning of T1 is after the end of T2, or the end of T1 is before the beginning of T2, i.e. the intervals do not overlap in any way, but their ordering relationship is not known."@en, "Si un intervalo propio T1 es disjunto con otro intervalo propio T2, entonces el principio de T1 está después del final de T2, o el final de T1 está antes que el principio de T2, es decir, los intervalos no se solapan de ninguna forma, aunque su relación de orden no se conozca."@es ;
  skos:note "Esta relación entre intervalos no estaba incluida en las 13 relaciones básicas definidas por Allen (1984), pero está definida en T.3 como la unión de 'intervalo anterior' con 'intervalo posterior'. Sin embargo, esto está fuera de la expresividad de OWL2, por tanto, está implementado como una propiedad explícita, con 'intervalo anterior' e 'intervalo posterior' como sub-propiedades."@es, "This interval relation is not included in the 13 basic relationships defined in Allen (1984), but is defined in (T.3) as the union of :intervalBefore v :intervalAfter . However, that is outside OWL2 expressivity, so is implemented as an explicit property, with :intervalBefore , :intervalAfter as sub-properties"@en, "This interval relation is not included in the 13 basic relationships defined in Allen (1984), but is defined in (T.3) as the union of time:intervalBefore v time:intervalAfter . However, that is outside OWL2 expressivity, so is implemented as an explicit property, with time:intervalBefore , time:intervalAfter as sub-properties"@en .

time:intervalDuring
  a owl:ObjectProperty ;
  rdfs:subPropertyOf time:intervalIn ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en, "Si un intervalo propio T1 está durante otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 está antes que el final de T2."@es ;
  rdfs:label "interval during"@en, "intervalo durante"@es ;
  skos:definition "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en, "Si un intervalo propio T1 está durante otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 está antes que el final de T2."@es .

time:intervalEquals
  a owl:ObjectProperty ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  owl:propertyDisjointWith time:intervalIn ;
  rdfs:comment "If a proper interval T1 is intervalEquals another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is coincident with the end of T2."@en, "Si un intervalo propio T1 es igual a otro intervalo propio T2, entonces el principio de T1 coincide con el principio de T2, y el final de T1 coincide con el final de T2."@es ;
  rdfs:label "interval equals"@en, "intervalo igual"@es ;
  skos:definition "If a proper interval T1 is intervalEquals another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is coincident with the end of T2."@en, "Si un intervalo propio T1 es igual a otro intervalo propio T2, entonces el principio de T1 coincide con el principio de T2, y el final de T1 coincide con el final de T2."@es .

time:intervalFinishedBy
  a owl:ObjectProperty ;
  owl:inverseOf time:intervalFinishes ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalFinishedBy another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is coincident with the end of T2."@en, "Si un intervalo propio T1 está terminado por otro intervalo propio T2, entonces el principio de T1 está antes que el principio de T2, y el final de T1 coincide con el final de T2."@es ;
  rdfs:label "interval finished by"@en, "intervalo terminado por"@es ;
  skos:definition "If a proper interval T1 is intervalFinishedBy another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is coincident with the end of T2."@en, "Si un intervalo propio T1 está terminado por otro intervalo propio T2, entonces el principio de T1 está antes que el principio de T2, y el final de T1 coincide con el final de T2."@es .

time:intervalFinishes
  a owl:ObjectProperty ;
  rdfs:subPropertyOf time:intervalIn ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en, "Si un intervalo propio T1 termina otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 coincide con el final de T2."@es ;
  rdfs:label "interval finishes"@en, "intervalo termina"@es ;
  skos:definition "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en, "Si un intervalo propio T1 termina otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 coincide con el final de T2."@es .

time:intervalIn
  a owl:ObjectProperty ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalIn another proper interval T2, then the beginning of T1 is after the beginning of T2 or is coincident with the beginning of T2, and the end of T1 is before the end of T2, or is coincident with the end of T2, except that end of T1 may not be coincident with the end of T2 if the beginning of T1 is coincident with the beginning of T2."@en, "Si un intervalo propio T1 es un intervalo interior a otro intervalo propio T2, entonces el principio de T1 está después del principio de T2 o coincide con el principio de T2, y el final de T1 está antes que el final de T2, o coincide con el final de T2, excepto que el final de T1 puede no coincidir con el final de T2 si el principio de T1 coincide con el principio de T2."@es ;
  rdfs:label "interval in"@en, "intervalo interior"@es ;
  skos:definition "If a proper interval T1 is intervalIn another proper interval T2, then the beginning of T1 is after the beginning of T2 or is coincident with the beginning of T2, and the end of T1 is before the end of T2, or is coincident with the end of T2, except that end of T1 may not be coincident with the end of T2 if the beginning of T1 is coincident with the beginning of T2."@en, "Si un intervalo propio T1 es un intervalo interior a otro intervalo propio T2, entonces el principio de T1 está después del principio de T2 o coincide con el principio de T2, y el final de T1 está antes que el final de T2, o coincide con el final de T2, excepto que el final de T1 puede no coincidir con el final de T2 si el principio de T1 coincide con el principio de T2."@es ;
  skos:note "Esta relación entre intervalos no estaba incluida en las 13 relaciones básicas definidas por Allen (1984), pero se hace referencia a ella como \"una relación importante\" en Allen y Ferguson (1997). Es la unión disjunta de 'intervalo empieza', 'intervalo durante' y con 'intervalo termina'. Sin embargo, esto está fuera de la expresividad de OWL2, por tanto, se implementa como una propiedad explícita, con 'intervalo empieza', 'intervalo durante' e 'intervalo termina' como sub-propiedades."@es, "This interval relation is not included in the 13 basic relationships defined in Allen (1984), but is referred to as 'an important relationship' in Allen and Ferguson (1997). It is the disjoint union of :intervalStarts v :intervalDuring v :intervalFinishes . However, that is outside OWL2 expressivity, so is implemented as an explicit property, with :intervalStarts , :intervalDuring , :intervalFinishes as sub-properties"@en, "This interval relation is not included in the 13 basic relationships defined in Allen (1984), but is referred to as 'an important relationship' in Allen and Ferguson (1997). It is the disjoint union of time:intervalStarts v time:intervalDuring v time:intervalFinishes . However, that is outside OWL2 expressivity, so is implemented as an explicit property, with time:intervalStarts , time:intervalDuring , time:intervalFinishes as sub-properties"@en .

time:intervalMeets
  a owl:ObjectProperty ;
  owl:inverseOf time:intervalMetBy ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalMeets another proper interval T2, then the end of T1 is coincident with the beginning of T2."@en, "Si un intervalo propio T1 se encuentra con otro intervalo propio T2, entonces el final de T1 coincide con el principio de T2."@es ;
  rdfs:label "interval meets"@en, "intervalo se encuentra"@es ;
  skos:definition "If a proper interval T1 is intervalMeets another proper interval T2, then the end of T1 is coincident with the beginning of T2."@en, "Si un intervalo propio T1 se encuentra con otro intervalo propio T2, entonces el final de T1 coincide con el principio de T2."@es .

time:intervalMetBy
  a owl:ObjectProperty ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en, "Si un intervalo propio T1 es 'intervalo encontrado por' otro intervalo propio T2, entonces el principio de T1 coincide con el final de T2."@es ;
  rdfs:label "interval met by"@en, "intervalo encontrado por"@es ;
  skos:definition "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en, "Si un intervalo propio T1 es 'intervalo encontrado por' otro intervalo propio T2, entonces el principio de T1 coincide con el final de T2."@es .

time:intervalOverlappedBy
  a owl:ObjectProperty ;
  owl:inverseOf time:intervalOverlaps ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalOverlappedBy another proper interval T2, then the beginning of T1 is after the beginning of T2, the beginning of T1 is before the end of T2, and the end of T1 is after the end of T2."@en, "Si un intervalo propio T1 es 'intervalo solapado por' otro intervalo propio T2, entonces el principio de T1 es posterior al principio de T2, y el principio de T1 es anterior al final de T2, y el final de T1 es posterior al final de T2."@es ;
  rdfs:label "interval overlapped by"@en, "intervalo solapado por"@es ;
  skos:definition "If a proper interval T1 is intervalOverlappedBy another proper interval T2, then the beginning of T1 is after the beginning of T2, the beginning of T1 is before the end of T2, and the end of T1 is after the end of T2."@en, "Si un intervalo propio T1 es 'intervalo solapado por' otro intervalo propio T2, entonces el principio de T1 es posterior al principio de T2, y el principio de T1 es anterior al final de T2, y el final de T1 es posterior al final de T2."@es .

time:intervalOverlaps
  a owl:ObjectProperty ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es, "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en, "Si un intervalo propio T1 se solapa con otro intervalo propio T2, entonces el principio de T1 es anterior al principio de T2, el final de T1 es posterior al principio de T2, y el final de T1 es anterior al final de T2."@es ;
  rdfs:label "interval overlaps"@en, "intervalo se solapa"@es ;
  skos:definition "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en, "Si un intervalo propio T1 se solapa con otro intervalo propio T2, entonces el principio de T1 es anterior al principio de T2, el final de T1 es posterior al principio de T2, y el final de T1 es anterior al final de T2."@es .

time:intervalStartedBy
  a owl:ObjectProperty ;
  owl:inverseOf time:intervalStarts ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalStarted another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is after the end of T2."@en, "Si un intervalo propio T1 es empezado por otro intervalo propio T2, entonces el principio de T1 coincide con el principio de T2, y el final de T1 es posterior al final de T2."@es ;
  rdfs:label "interval started by"@en ;
  skos:definition "If a proper interval T1 is intervalStarted another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is after the end of T2."@en, "Si un intervalo propio T1 es empezado por otro intervalo propio T2, entonces el principio de T1 coincide con el principio de T2, y el final de T1 es posterior al final de T2."@es .

time:intervalStarts
  a owl:ObjectProperty ;
  rdfs:subPropertyOf time:intervalIn ;
  rdfs:domain time:ProperInterval ;
  rdfs:range time:ProperInterval ;
  rdfs:comment "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en, "Si un intervalo propio T1 empieza otro intervalo propio T2, entonces del principio de T1 con el principio de T2, y el final de T1 es anterior al final de T2."@es ;
  rdfs:label "interval starts"@en, "intervalo empieza"@es ;
  skos:definition "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en, "Si un intervalo propio T1 empieza otro intervalo propio T2, entonces del principio de T1 con el final de T2, y el final de T1 es anterior al final de T2."@es .

prov:alternateOf
  a owl:ObjectProperty ;
  rdfs:domain prov:Entity ;
  rdfs:range prov:Entity ;
  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
  rdfs:label "alternateOf" ;
  rdfs:seeAlso prov:specializationOf ;
  prov:category "expanded" ;
  prov:component "alternate" ;
  prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
  prov:definition "Two alternate entities present aspects of the same thing. These aspects may be the same or different, and the alternate entities may or may not overlap in time."@en ;
  prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-alternate"^^xsd:anyURI ;
  prov:inverse "alternateOf" ;
  prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-alternate"^^xsd:anyURI .

prov:specializationOf
  a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:alternateOf ;
  rdfs:domain prov:Entity ;
  rdfs:isDefinedBy prov:, <http://www.w3.org/ns/prov-o#> ;
  rdfs:label "specializationOf" ;
  rdfs:seeAlso prov:alternateOf ;
  prov:category "expanded" ;
  prov:component "alternate" ;
  prov:constraints "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-constraints.html#prov-dm-constraints-fig"^^xsd:anyURI, "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
  prov:definition "An entity that is a specialization of another shares all aspects of the latter, and additionally presents more specific aspects of the same thing as the latter. In particular, the lifetime of the entity being specialized contains that of any specialization. Examples of aspects include a time period, an abstraction, and a context associated with the entity."@en ;
  prov:dm "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-dm.html#term-specialization"^^xsd:anyURI, "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-specialization"^^xsd:anyURI ;
  prov:inverse "generalizationOf" ;
  prov:n "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-n.html#expression-specialization"^^xsd:anyURI, "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-specialization"^^xsd:anyURI .

prov:wasDerivedFrom
  a owl:ObjectProperty ;
  rdfs:domain prov:Entity ;
  rdfs:range prov:Entity ;
  rdfs:comment "The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable."@en ;
  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
  rdfs:label "est dérivé de"@fr, "was derived from"@en, "wasDerivedFrom" ;
  prov:category "starting-point" ;
  prov:component "derivations" ;
  prov:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en ;
  prov:inverse "hadDerivation" ;
  prov:qualifiedForm prov:Derivation, prov:qualifiedDerivation .

prov:wasRevisionOf
  a owl:ObjectProperty ;
  rdfs:subPropertyOf prov:wasDerivedFrom ;
  rdfs:domain prov:Entity ;
  rdfs:comment "A revision is a derivation that revises an entity into a revised version."@en ;
  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
  rdfs:label "wasRevisionOf" ;
  prov:category "expanded" ;
  prov:component "derivations" ;
  prov:inverse "hadRevision" ;
  prov:qualifiedForm prov:Revision, prov:qualifiedRevision .

<https://w3id.org/PeGazUs#appliedTo>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#changedBy> ;
  rdfs:domain <https://w3id.org/PeGazUs#Change> ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
     <https://w3id.org/PeGazUs#Attribute>
     <https://w3id.org/PeGazUs#Landmark>
     <https://w3id.org/PeGazUs#LandmarkRelation>
   )
  ] ;
  rdfs:comment "Defines what the change applies to"@en, "Définit sur quoi s'applique le changement"@fr ;
  rdfs:label "is applied to"@en, "s'applique"@fr .

<https://w3id.org/PeGazUs#changedBy>
  a owl:ObjectProperty ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
     <https://w3id.org/PeGazUs#Attribute>
     <https://w3id.org/PeGazUs#Landmark>
     <https://w3id.org/PeGazUs#LandmarkRelation>
   )
  ] ;
  rdfs:range <https://w3id.org/PeGazUs#Change> ;
  rdfs:comment "Defines the change applied to the element"@en, "Définit le changement qui est appliqué à l'élément"@fr ;
  rdfs:label "changé par"@fr, "is changed by"@en .

<https://w3id.org/PeGazUs#dependsOn>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#hasChange> ;
  rdfs:domain <https://w3id.org/PeGazUs#Change> ;
  rdfs:range <https://w3id.org/PeGazUs#Event> ;
  rdfs:comment "Describes whether a change belongs to an event"@en, "Décrit l'appartenance d'un changement à un événement"@fr ;
  rdfs:label "depends on the event"@en, "dépend de l'événement"@fr .

<https://w3id.org/PeGazUs#differentVersionValueFrom>
  a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:range <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:comment "Indicates that two versions of attributes have different values"@en, "Indique que deux versions d'attributs ont des valeurs différents"@fr ;
  rdfs:label "a une valeur différente de"@fr, "has different version value from"@en .

<https://w3id.org/PeGazUs#eventAfter>
  a owl:ObjectProperty, owl:TransitiveProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#eventBefore> ;
  rdfs:domain <https://w3id.org/PeGazUs#Event> ;
  rdfs:range <https://w3id.org/PeGazUs#Event> ;
  rdfs:comment "Describes the temporal relationship of posteriority between two events"@en, "Décrit la relation temporelle de postériorité entre deux événements"@fr ;
  rdfs:label "est après"@fr, "is after"@en .

<https://w3id.org/PeGazUs#eventBefore>
  a owl:ObjectProperty, owl:TransitiveProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#Event> ;
  rdfs:range <https://w3id.org/PeGazUs#Event> ;
  rdfs:comment "Describes the temporal relationship of anteriority between two events"@en, "Décrit la relation temporelle d'antériorité entre deux événéments"@fr ;
  rdfs:label "est avant"@fr, "is before"@en .

<https://w3id.org/PeGazUs#eventSameTime>
  a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#Event> ;
  rdfs:range <https://w3id.org/PeGazUs#Event> ;
  rdfs:comment "Describes the temporal relationship of simultaneity between two events"@en, "Décrit la relation temporelle de simultanéité entre deux événements"@fr ;
  rdfs:label "est en même temps que"@fr, "is at the same time"@en .

<https://w3id.org/PeGazUs#firstStep>
  a owl:ObjectProperty ;
  rdfs:subPropertyOf <https://w3id.org/PeGazUs#hasStep> ;
  rdfs:domain <https://w3id.org/PeGazUs#Address> ;
  rdfs:range <https://w3id.org/PeGazUs#AddressSegment> ;
  rdfs:comment "First step of an Address"@en, "Première étape de l'adresse."@fr ;
  rdfs:label "a pour première étape"@fr, "has first step"@en ;
  skos:altLabel "a pour premier segment d'adresse"@fr, "has as its first Address segment"@en .

<https://w3id.org/PeGazUs#hasAttribute>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#isAttributeOf> ;
  rdfs:domain owl:Thing ;
  rdfs:range <https://w3id.org/PeGazUs#Attribute> ;
  rdfs:comment "Describes the attribute for an element"@en, "Décrit l'attribut pour un élement"@fr ;
  rdfs:label "a pour attribut"@fr, "has attribute"@en .

<https://w3id.org/PeGazUs#hasAttributeVersion>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#isAttributeVersionOf> ;
  rdfs:domain <https://w3id.org/PeGazUs#Attribute> ;
  rdfs:range <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:comment "Version d'une valeur associée à l'attribut"@fr, "Version of a value associated with the attribute"@en ;
  rdfs:label "a pour version"@fr, "has version"@en .

<https://w3id.org/PeGazUs#hasBeginning>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#TimeInterval> ;
  rdfs:range <https://w3id.org/PeGazUs#TimeInstant> ;
  rdfs:comment "Début de l'intervalle temporel"@fr, "Start of time interval"@en ;
  rdfs:label "commence par"@fr, "has beginning"@en .

<https://w3id.org/PeGazUs#hasChange>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#Event> ;
  rdfs:range <https://w3id.org/PeGazUs#Change> ;
  rdfs:comment "Defines the changes linked to the event"@en, "Définit les changements qui sont liés à l'événement"@fr ;
  rdfs:label "comporte le changement"@fr, "has change"@en .

<https://w3id.org/PeGazUs#hasEarliestTimeInstant>
  a owl:ObjectProperty ;
  rdfs:subPropertyOf <https://w3id.org/PeGazUs#hasTimeAfter> ;
  rdfs:range <https://w3id.org/PeGazUs#TemporalInstant> ;
  rdfs:comment "Earliest time linked to the resource"@en, "Instant au plus tôt lié à la ressource"@fr ;
  rdfs:label "has earliest time instant"@en, "instant au plus tôt"@fr .

<https://w3id.org/PeGazUs#hasEnd>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#TimeInterval> ;
  rdfs:range <https://w3id.org/PeGazUs#TimeInstant> ;
  rdfs:comment "End of time interval"@en, "Fin de l'intervalle temporel"@fr ;
  rdfs:label "finit par"@fr, "has end"@en .

<https://w3id.org/PeGazUs#hasFuzzyBeginning>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#FuzzyTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Defines the start of validity for a fuzzy instant"@en, "Définit le début de validité pour un instant flou"@fr ;
  rdfs:label "a pour début flou"@fr, "has fuzzy beginning"@en .

<https://w3id.org/PeGazUs#hasFuzzyEnd>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#FuzzyTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Defines the end of validity for a fuzzy instant"@en, "Définit la fin de validité pour un instant flou"@fr ;
  rdfs:label "a pour fin floue"@fr, "has fuzzy end"@en .

<https://w3id.org/PeGazUs#hasFuzzyPeak>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#FuzzyTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Defines the validity peak for a fuzzy instant"@en, "Définit le pic de validité pour un instant flou"@fr ;
  rdfs:label "a pour pic flou"@fr, "has fuzzy peak"@en .

<https://w3id.org/PeGazUs#hasLatestTimeInstant>
  a owl:ObjectProperty ;
  rdfs:subPropertyOf <https://w3id.org/PeGazUs#hasTimeBefore> ;
  rdfs:range <https://w3id.org/PeGazUs#TemporalInstant> ;
  rdfs:comment "Instant au plus tard lié à la ressource"@fr, "Latest time linked to the resource"@en ;
  rdfs:label "has latest time instant"@en, "instant au plus tard"@fr .

<https://w3id.org/PeGazUs#hasNextVersion>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#hasPreviousVersion> ;
  rdfs:comment "Describes that one landmark version precedes another"@en, "Décrit qu'une version de repère en précède une autre"@fr ;
  rdfs:label "a pour version suivante"@fr, "has next version"@en .

<https://w3id.org/PeGazUs#hasOverlappingVersion>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#isOverlappedByVersion> ;
  rdfs:comment "Describes that one landmark version overlaps another"@en, "Décrit qu'une version de repère en chevauche une autre"@fr ;
  rdfs:label "chevauche la version"@fr, "overlaps version"@en .

<https://w3id.org/PeGazUs#hasPreviousVersion>
  a owl:ObjectProperty ;
  rdfs:comment "Describes that one landmark version follows another"@en, "Décrit qu'une version de repère en succède à une autre"@fr ;
  rdfs:label "a pour version précédente"@fr, "has previous version"@en .

<https://w3id.org/PeGazUs#hasRoot>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#isRootOf> ;
  rdfs:comment "Describes that an element has another element of reference as its root"@en, "Décrit qu'un élément a pour racine un autre élement"@fr ;
  rdfs:label "a pour racine"@fr, "has root"@en .

<https://w3id.org/PeGazUs#hasRootLandmark>
  a owl:ObjectProperty ;
  rdfs:subPropertyOf <https://w3id.org/PeGazUs#hasRoot> ;
  owl:inverseOf <https://w3id.org/PeGazUs#isRootLandmarkOf> ;
  rdfs:comment "Describes that an landmark has another landmark as its root"@en, "Décrit qu'un repère a pour racine un autre repère"@fr ;
  rdfs:label "a pour racine"@fr, "has root"@en .

<https://w3id.org/PeGazUs#hasStep>
  a owl:ObjectProperty, owl:TransitiveProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#isStepOf> ;
  rdfs:domain <https://w3id.org/PeGazUs#Address> ;
  rdfs:range <https://w3id.org/PeGazUs#AddressSegment> ;
  owl:propertyChainAxiom (
   <https://w3id.org/PeGazUs#firstStep>
   <https://w3id.org/PeGazUs#nextStep>
 ), (
   <https://w3id.org/PeGazUs#hasStep>
   <https://w3id.org/PeGazUs#nextStep>
 ) ;
  rdfs:comment "Describes that an address has an address segment as its step"@en, "Décrit qu'une adresse à pour étape un segment d'adresse"@fr ;
  rdfs:label "a pour étape"@fr, "has step"@en .

<https://w3id.org/PeGazUs#hasTime>
  a owl:ObjectProperty ;
  rdfs:range <https://w3id.org/PeGazUs#TemporalEntity> ;
  rdfs:comment "Time value linked to a resource"@en, "Valeur temporelle liée à une ressource"@fr ;
  rdfs:label "a pour valeur temporelle"@fr, "has time"@en .

<https://w3id.org/PeGazUs#hasTimeAfter>
  a owl:ObjectProperty ;
  rdfs:range <https://w3id.org/PeGazUs#TemporalInstant> ;
  rdfs:comment "Indicates that the resource is linked to an instant prior to the associated instant"@en, "Indique que la ressource est liée à un instant situé avant l'instant associé"@fr ;
  rdfs:label "occurs after"@en, "se passe après"@fr .

<https://w3id.org/PeGazUs#hasTimeBefore>
  a owl:ObjectProperty ;
  rdfs:range <https://w3id.org/PeGazUs#TemporalInstant> ;
  rdfs:comment "Indicates that the resource is linked to a time after the associated time"@en, "Indique que la ressource est liée à un instant situé après l'instant associé"@fr ;
  rdfs:label "occurs before"@en, "se passe avant"@fr .

<https://w3id.org/PeGazUs#hasTrace>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#isTraceOf> ;
  rdfs:comment "Describes that an element has another element as its trace"@en, "Décrit qu'un élément a pour trace un autre élément"@fr ;
  rdfs:label "a pour trace"@fr, "has trace"@en .

<https://w3id.org/PeGazUs#instantAfter>
  a owl:ObjectProperty, owl:TransitiveProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#instantBefore> ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Describes the temporal relationship of posteriority between two instants"@en, "Décrit la relation temporelle de postériorité entre deux instants"@fr ;
  rdfs:label "est après"@fr, "is after"@en .

<https://w3id.org/PeGazUs#instantAsPreciseAs>
  a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Compare les précisions temporelles entre deux instants"@fr, "Compares time accuracies between two instants"@en ;
  rdfs:label "est aussi précis que"@fr, "is as precise as"@en .

<https://w3id.org/PeGazUs#instantBefore>
  a owl:ObjectProperty, owl:TransitiveProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Describes the temporal relationship of anteriority between two instants"@en, "Décrit la relation temporelle d'antériorité entre deux instants"@fr ;
  rdfs:label "est avant"@fr, "is before"@en .

<https://w3id.org/PeGazUs#instantLessPreciseThan>
  a owl:ObjectProperty, owl:TransitiveProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#instantMorePreciseThan> ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Compare les précisions temporelles entre deux instants"@fr, "Compares time accuracies between two instants"@en ;
  rdfs:label "est moins précis que"@fr, "is less precise than"@en .

<https://w3id.org/PeGazUs#instantMorePreciseThan>
  a owl:ObjectProperty, owl:TransitiveProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Compare les précisions temporelles entre deux instants"@fr, "Compares time accuracies between two instants"@en ;
  rdfs:label "est plus précis que"@fr, "is more precise than"@en .

<https://w3id.org/PeGazUs#instantSameTime>
  a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:comment "Describes the temporal relationship of simultaneity between two instants"@en, "Décrit la relation temporelle de simultanéité entre deux instants"@fr ;
  rdfs:label "est en même temps que"@fr, "is at the same time"@en .

<https://w3id.org/PeGazUs#isAttributeOf>
  a owl:ObjectProperty ;
  rdfs:comment "Defines the frame of reference for which the attribute exists"@en, "Définit le repère pour lequel l'attribut existe"@fr ;
  rdfs:label "est un attribut de"@fr, "is attribute of"@en .

<https://w3id.org/PeGazUs#isAttributeType>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#Attribute> ;
  rdfs:range <https://w3id.org/PeGazUs#AttributeType> ;
  rdfs:comment "Describes the type of attribute."@en, "Décrit le type d'attribut."@fr ;
  rdfs:label "est un attribut de type"@fr, "is attribute type"@en .

<https://w3id.org/PeGazUs#isAttributeVersionOf>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:range <https://w3id.org/PeGazUs#Attribute> ;
  rdfs:comment "Attribut associée à la version d'attribut"@fr, "Attribute associated with the attribute version"@en ;
  rdfs:label "est une version de l'attribut"@fr, "is attribute version of"@en .

<https://w3id.org/PeGazUs#isChangeType>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#Change> ;
  rdfs:range <https://w3id.org/PeGazUs#ChangeType> ;
  rdfs:comment "Describes the type of change."@en, "Décrit le type de changement."@fr ;
  rdfs:label "est une changement de type"@fr, "is change type"@en .

<https://w3id.org/PeGazUs#isLandmarkRelationType>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#LandmarkRelation> ;
  rdfs:range <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  rdfs:comment "Describes the type of landmark relation."@en, "Décrit le type de relation entre repères définie par la ressource."@fr ;
  rdfs:label "est une relation entre repères de type"@fr, "is landmark relation type"@en .

<https://w3id.org/PeGazUs#isLandmarkType>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#Landmark> ;
  rdfs:range <https://w3id.org/PeGazUs#LandmarkType> ;
  rdfs:comment "Describes the type of landmark."@en, "Décrit le type de repère définie par la ressource."@fr ;
  rdfs:label "est un repère de type"@fr, "is landmark type"@en .

<https://w3id.org/PeGazUs#isMadeEffectiveBy>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#makesEffective> ;
  rdfs:domain <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:range <https://w3id.org/PeGazUs#AttributeChange> ;
  rdfs:comment "Describes the fact that a version of an attribute is made effective by a change"@en, "Décrit le fait qu'une version d'un attribut est rendue effectif par un changement"@fr ;
  rdfs:label "est rendu effectif par"@fr, "is made effective by"@en .

<https://w3id.org/PeGazUs#isOutdatedBy>
  a owl:ObjectProperty ;
  owl:inverseOf <https://w3id.org/PeGazUs#outdates> ;
  rdfs:domain <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:range <https://w3id.org/PeGazUs#AttributeChange> ;
  rdfs:comment "Describes the fact that a version of an attribute is rendered obsolete by a change"@en, "Décrit le fait qu'une version d'un attribut est rendue caduc par un changement"@fr ;
  rdfs:label "est rendu caduc par"@fr, "is outdated by"@en .

<https://w3id.org/PeGazUs#isOverlappedByVersion>
  a owl:ObjectProperty ;
  rdfs:comment "Describes that one landmark version is overlapped by another"@en, "Décrit qu'une version de repère est chevauchée par une autre"@fr ;
  rdfs:label "est chevauché par"@fr, "is overlapped by version"@en .

<https://w3id.org/PeGazUs#isRootLandmarkOf>
  a owl:ObjectProperty ;
  rdfs:subPropertyOf <https://w3id.org/PeGazUs#isRootOf> ;
  rdfs:comment "Describes that an landmark is the root of another"@en, "Décrit qu'un repère est la racine d'un autre"@fr ;
  rdfs:label "est racine de"@fr, "is root of"@en .

<https://w3id.org/PeGazUs#isRootOf>
  a owl:ObjectProperty ;
  rdfs:comment "Describes that an element is the root of another"@en, "Décrit qu'un élément est la racine d'un autre"@fr ;
  rdfs:label "est racine de"@fr, "is root of"@en .

<https://w3id.org/PeGazUs#isStepOf>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#AddressSegment> ;
  rdfs:range <https://w3id.org/PeGazUs#Address> ;
  rdfs:comment "Describes that an address segment is a step of an address"@en, "Décrit qu'un segment d'adresse est une étape d'une adresse"@fr ;
  rdfs:label "est une étape de"@fr, "is a step of"@en .

<https://w3id.org/PeGazUs#isTraceOf>
  a owl:ObjectProperty ;
  rdfs:comment "Describes that an element is the trace of another element"@en, "Décrit qu'un élément est la trace d'un autre élément"@fr ;
  rdfs:label "est une trace de"@fr, "is trace of"@en .

<https://w3id.org/PeGazUs#locatum>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#LandmarkRelation> ;
  rdfs:range <https://w3id.org/PeGazUs#Landmark> ;
  rdfs:comment "Donne le repère qui est le locatum pour la relation entre repères"@fr, "Gives the landmark which is the locatum for the landmark relation"@en ;
  rdfs:label "a pour locatum"@fr, "has locatum"@en .

<https://w3id.org/PeGazUs#makesEffective>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#AttributeChange> ;
  rdfs:range <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:comment "Describes the fact that a change makes a version of an attribute effective"@en, "Décrit le fait qu'un changement rend effectif une version d'un attribut"@fr ;
  rdfs:label "makes effective"@en, "rend effectif"@fr .

<https://w3id.org/PeGazUs#nextStep>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#AddressSegment> ;
  rdfs:range <https://w3id.org/PeGazUs#AddressSegment> ;
  rdfs:comment "Describes that an address segment is followed by another address segment"@en, "Décrit qu'un segment d'adresse est suivi par un autre segment d'adresse"@fr ;
  rdfs:label "a pour prochaine étape"@fr, "has next step"@en ;
  skos:altLabel "est suivi par"@fr, "is followed by"@en .

<https://w3id.org/PeGazUs#outdates>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#AttributeChange> ;
  rdfs:range <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:comment "Describes the fact that a change invalidates a version of an attribute"@en, "Décrit le fait qu'un changement rend caduc une version d'un attribut"@fr ;
  rdfs:label "outdates"@en, "rend caduc"@fr .

<https://w3id.org/PeGazUs#relatum>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#LandmarkRelation> ;
  rdfs:range <https://w3id.org/PeGazUs#Landmark> ;
  rdfs:comment "Donne l'entité géographique qui est un des relatums pour la relation entre repères"@fr, "Gives the landmark which is one of the relatums for the landmark relation"@en ;
  rdfs:label "a pour relatum"@fr, "has relatum"@en .

<https://w3id.org/PeGazUs#sameVersionValueAs>
  a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:range <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:comment "Indicates that two versions of attributes have similar values"@en, "Indique que deux versions d'attributs ont des valeurs similaires"@fr ;
  rdfs:label "a une valeur similaire à"@fr, "has same version value as"@en .

<https://w3id.org/PeGazUs#targets>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#Address> ;
  rdfs:range <https://w3id.org/PeGazUs#Landmark> ;
  rdfs:comment "Cible le repère décrivant l'adresse."@fr, "Target the marker describing the Address"@en ;
  rdfs:label "cible"@fr, "targets"@en .

<https://w3id.org/PeGazUs#timeCalendar>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range time:TRS ;
  rdfs:comment "Calendrier lié à l'instant (grégorien, julien, révolutionnaire)"@fr, "Time-based calendar (Gregorian, Julian, Revolutionary)"@en ;
  rdfs:label "a pour calendrier"@fr, "has calendar"@en .

<https://w3id.org/PeGazUs#timePrecision>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range time:TemporalUnit ;
  rdfs:comment "Précision de l'instant (au jour, au mois, à l'année...)"@fr, "Time accuracy (to the day, month, year, etc.)"@en ;
  rdfs:label "a pour précision temporelle"@fr, "has time precision"@en .

<https://w3id.org/PeGazUs#versionOf>
  a owl:ObjectProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#LandmarkVersion> ;
  rdfs:range <https://w3id.org/PeGazUs#Landmark> ;
  rdfs:comment "Defines which landmark a version depends on"@en, "Définit pour une version de quel repère elle dépend"@fr ;
  rdfs:label "est une version de repère de"@fr, "is a version of"@en .

time:days
  a owl:DatatypeProperty ;
  rdfs:domain time:GeneralDurationDescription ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Longitud de, o elemento de la longitud de, una extensión temporal expresada en días."@es, "length of, or element of the length of, a temporal extent expressed in days"@en ;
  rdfs:label "days duration"@en, "duración en días"@es ;
  skos:definition "Longitud de, o elemento de la longitud de, una extensión temporal expresada en días."@es, "length of, or element of the length of, a temporal extent expressed in days"@en .

time:hours
  a owl:DatatypeProperty ;
  rdfs:domain time:GeneralDurationDescription ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Longitud de, o elemento de la longitud de, una extensión temporal expresada en horas."@es, "length of, or element of the length of, a temporal extent expressed in hours"@en ;
  rdfs:label "duración en horas"@es, "hours duration"@en ;
  skos:definition "Longitud de, o elemento de la longitud de, una extensión temporal expresada en horas."@es, "length of, or element of the length of, a temporal extent expressed in hours"@en .

time:minutes
  a owl:DatatypeProperty ;
  rdfs:domain time:GeneralDurationDescription ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Longitud de, o elemento de la longitud de, una extensión temporal expresada en minutos."@es, "length, or element of, a temporal extent expressed in minutes"@en ;
  rdfs:label "minutes"@en, "minutos"@es ;
  skos:definition "Longitud de, o elemento de la longitud de, una extensión temporal expresada en minutos."@es, "length, or element of, a temporal extent expressed in minutes"@en .

time:months
  a owl:DatatypeProperty ;
  rdfs:domain time:GeneralDurationDescription ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Longitud de, o elemento de la longitud de, una extensión temporal expresada en meses."@es, "length of, or element of the length of, a temporal extent expressed in months"@en ;
  rdfs:label "duración en meses"@es, "months duration"@en ;
  skos:definition "Longitud de, o elemento de la longitud de, una extensión temporal expresada en meses."@es, "length of, or element of the length of, a temporal extent expressed in months"@en .

time:seconds
  a owl:DatatypeProperty ;
  rdfs:domain time:GeneralDurationDescription ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Longitud de, o elemento de la longitud de, una extensión temporal expresada en segundos."@es, "length of, or element of the length of, a temporal extent expressed in seconds"@en ;
  rdfs:label "duración en segundos"@es, "seconds duration"@en ;
  rdfs:seeAlso <http://www.bipm.org/en/publications/si-brochure/second.html> .

time:weeks
  a owl:DatatypeProperty ;
  rdfs:domain time:GeneralDurationDescription ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Longitud de, o elemento de la longitud de, una extensión temporal expresada en semanas."@es, "length of, or element of the length of, a temporal extent expressed in weeks"@en ;
  rdfs:label "duración en semanas"@es, "weeks duration"@en .

time:years
  a owl:DatatypeProperty ;
  rdfs:domain time:GeneralDurationDescription ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Longitud de, o elemento de la longitud de, una extensión temporal expresada en años."@es, "length of, or element of the length of, a temporal extent expressed in years"@en ;
  rdfs:label "duración en años"@es, "years duration"@en .

<https://w3id.org/PeGazUs#timeStamp>
  a owl:DatatypeProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#CrispTimeInstant> ;
  rdfs:range xsd:dateTimeStamp ;
  rdfs:comment "Timestamp lié à l'instant"@fr ;
  rdfs:label "a pour timestamp"@fr .

<https://w3id.org/PeGazUs#versionValue>
  a owl:DatatypeProperty ;
  rdfs:domain <https://w3id.org/PeGazUs#AttributeVersion> ;
  rdfs:comment "Valeur de liée à une version d'attribut"@fr, "Value linked to an attribute version"@en ;
  rdfs:label "a pour valeur"@fr, "has version value"@en .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .
skos:Concept
  a owl:Class ;
  owl:disjointWith skos:ConceptScheme ;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
  rdfs:label "Concept"@en ;
  skos:definition "An idea or notion; a unit of thought."@en .

skos:ConceptScheme
  a owl:Class ;
  rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
  rdfs:label "Concept Scheme"@en ;
  skos:definition "A set of concepts, optionally including statements about semantic relationships between those concepts."@en ;
  skos:example "Thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', and other types of controlled vocabulary are all examples of concept schemes. Concept schemes are also embedded in glossaries and terminologies."@en ;
  skos:scopeNote "A concept scheme may be defined to include concepts from different sources."@en .

time:GeneralDurationDescription
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty time:hasTRS ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:days ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:hours ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:minutes ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:months ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:seconds ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:weeks ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:years ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario."@es, "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en ;
  rdfs:label "Generalized duration description"@en, "descripción de duración generalizada"@es ;
  skos:definition "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario."@es, "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en ;
  skos:note "La extensión de una duración de tiempo expresada como una 'descripción de duración general' depende del Sistema de Referencia Temporal. En algunos calendarios la longitud de la semana o del mes no es constante a lo largo del año. Por tanto, un valor como \"25 meses\" puede no ser necesariamente ser comparado con un duración similar expresada en términos de semanas o días. Cuando se consideran calendarios que no están basados en el movimiento de la Tierra, se deben tomar incluso más precauciones en la comparación de duraciones."@es, "The extent of a time duration expressed as a GeneralDurationDescription depends on the Temporal Reference System. In some calendars the length of the week or month is not constant within the year. Therefore, a value like \"2.5 months\" may not necessarily be exactly compared with a similar duration expressed in terms of weeks or days. When non-earth-based calendars are considered even more care must be taken in comparing durations."@en .

time:Instant
  a owl:Class ;
  rdfs:subClassOf time:TemporalEntity ;
  owl:disjointWith time:ProperInterval ;
  rdfs:comment "A temporal entity with zero extent or duration"@en, "Una entidad temporal con una extensión o duración cero."@es ;
  rdfs:label "Time instant"@en, "instante de tiempo."@es ;
  skos:definition "A temporal entity with zero extent or duration"@en, "Una entidad temporal con una extensión o duración cero."@es .

time:Interval
  a owl:Class ;
  rdfs:subClassOf time:TemporalEntity ;
  rdfs:comment "A temporal entity with an extent or duration"@en, "Una entidad temporal con una extensión o duración."@es ;
  rdfs:label "Time interval"@en, "intervalo de tiempo"@es ;
  skos:definition "A temporal entity with an extent or duration"@en, "Una entidad temporal con una extensión o duración."@es .

time:ProperInterval
  a owl:Class ;
  rdfs:subClassOf time:Interval ;
  rdfs:comment "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en, "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es ;
  rdfs:label "Proper interval"@en, "intervalo propio"@es ;
  skos:definition "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en, "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es .

time:TRS
  a owl:Class ;
  rdfs:comment """A temporal reference system, such as a temporal coordinate system (with an origin, direction, and scale), a calendar-clock combination, or a (possibly hierarchical) ordinal system. 

This is a stub class, representing the set of all temporal reference systems."""@en, """Un sistema de referencia temporal, tal como un sistema de coordenadas temporales (con un origen, una dirección y una escala), una combinación calendario-reloj, o un sistema ordinal (posiblemente jerárquico).
        Esta clase comodín representa el conjunto de todos los sistemas de referencia temporal."""@es ;
  rdfs:label "Temporal Reference System"@en, "sistema de referencia temporal"@es ;
  skos:definition """A temporal reference system, such as a temporal coordinate system (with an origin, direction, and scale), a calendar-clock combination, or a (possibly hierarchical) ordinal system. 

This is a stub class, representing the set of all temporal reference systems."""@en, """Un sistema de referencia temporal, tal como un sistema de coordenadas temporales (con un origen, una dirección y una escala), una combinación calendario-reloj, o un sistema ordinal (posiblemente jerárquico).
    Esta clase comodín representa el conjunto de todos los sistemas de referencia temporal."""@es ;
  skos:note "A taxonomy of temporal reference systems is provided in ISO 19108:2002 [ISO19108], including (a) calendar + clock systems; (b) temporal coordinate systems (i.e. numeric offset from an epoch); (c) temporal ordinal reference systems (i.e. ordered sequence of named intervals, not necessarily of equal duration)."@en, "En el ISO 19108:2002 [ISO19108] se proporciona una taxonomía de sistemas de referencia temporal, incluyendo (a) sistemas de calendario + reloj; (b) sistemas de coordenadas temporales (es decir, desplazamiento numérico a partir de una época); (c) sistemas de referencia ordinales temporales (es decir, secuencia ordenada de intervalos nombrados, no necesariamente de igual duración)."@es .

time:TemporalEntity
  a owl:Class ;
  owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
     time:Instant
     time:Interval
   )
  ] ;
  rdfs:comment "A temporal interval or instant."@en, "Un intervalo temporal o un instante."@es ;
  rdfs:label "Temporal entity"@en, "entidad temporal"@es ;
  skos:definition "A temporal interval or instant."@en, "Un intervalo temporal o un instante."@es .

time:TemporalPosition
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty time:hasTRS ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "A position on a time-line"@en, "Una posición sobre una línea de tiempo."@es ;
  rdfs:label "Temporal position"@en, "posición temporal"@es ;
  skos:definition "A position on a time-line"@en, "Una posición sobre una línea de tiempo."@es .

time:TemporalUnit
  a owl:Class ;
  rdfs:comment "A standard duration, which provides a scale factor for a time extent, or the granularity or precision for a time position."@en, "Una duración estándar, que proporciona un factor de escala para una extensión de tiempo, o la granularidad o precisión para una posición de tiempo."@es ;
  rdfs:label "Temporal unit"@en, "unidad de tiempo"@es ;
  skos:changeNote """Remove enumeration from definition, in order to allow other units to be used when required in other coordinate systems. 
NOTE: existing units are still present as members of the class, but the class membership is now open. 

In the original OWL-Time the following constraint appeared: 
  owl:oneOf (
      time:unitSecond
      time:unitMinute
      time:unitHour
      time:unitDay
      time:unitWeek
      time:unitMonth
      time:unitYear
    ) ;"""@en ;
  skos:definition "A standard duration, which provides a scale factor for a time extent, or the granularity or precision for a time position."@en, "Una duración estándar, que proporciona un factor de escala para una extensión de tiempo, o la granularidad o precisión para una posición de tiempo."@es ;
  skos:note "La pertenencia de la clase 'unidad de tiempo' está abierta, para permitir otras unidades de tiempo utilizadas en algunas aplicaciones técnicas (por ejemplo, millones de años o el mes Baha'i)."@es, "Membership of the class TemporalUnit is open, to allow for other temporal units used in some technical applications (e.g. millions of years, Baha'i month)."@en .

org:Membership a owl:Class .
org:Role a owl:Class .
prov:Entity
  a owl:Class ;
  rdfs:comment "An entity is a physical, digital, conceptual or other element, which has certain fixed aspects; it can be real or imaginary."@en, "Une entité est un élément physique, numérique, conceptuel ou autre, possédant certains aspects fixes ; les entités peuvent être réelles ou imaginaires."@fr ;
  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
  rdfs:label "Entity", "Entity"@en, "entité"@fr ;
  prov:category "starting-point" ;
  prov:component "entities-activities" ;
  prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
  prov:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. "@en ;
  prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity"^^xsd:anyURI ;
  prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity"^^xsd:anyURI .

sd:NamedGraph a owl:Class .
foaf:Person a owl:Class .
<https://w3id.org/PeGazUs#Address>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#firstStep> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <https://w3id.org/PeGazUs#AddressSegment>
  ], [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#targets> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <https://w3id.org/PeGazUs#Landmark>
  ] ;
  rdfs:comment "An address defines an indirect spatial reference to a location that is the target of the address. This location is described as a sequence of address segments, each of which describes the relationships between entities."@en, "Une adresse définit une référence spatiale indirecte d'un lieu qui est la cible de l'adresse. La manière dont ce lieu est décrit se fait comme étant une séquence de segments d'adresse étant chacun une description de relations entre entités."@fr ;
  rdfs:label "Address"@en, "adresse"@fr .

<https://w3id.org/PeGazUs#AddressSegment>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#LandmarkRelation>, [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#relatum> ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <https://w3id.org/PeGazUs#Landmark>
  ], [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#locatum> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <https://w3id.org/PeGazUs#Landmark>
  ], [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#nextStep> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <https://w3id.org/PeGazUs#AddressSegment>
  ] ;
  rdfs:comment "An address segment describes a relationship between a landmark (the locatum) and one or more other landmarks (the relatums). An address segment may be followed by another address segment that describes a relationship between the locatum of the previous address segment and other landmarks."@en, "Un segment d'adresse décrit une relation entre un repère (le locatum) et un ou plusieurs autres repères (les relatums). Un segment d'adresse peut être suivi par un autre segment d'adresse qui décrit une relation entre le locatum du segment d'adresse précédent et d'autres repères."@fr ;
  rdfs:label "Address segment"@en, "segment d'adresse"@fr .

<https://w3id.org/PeGazUs#Attribute>
  a owl:Class ;
  rdfs:comment "An attribute is a property of a geographic entity."@en, "Un attribut est une propriété d'une entité géographique."@fr ;
  rdfs:label "Attribut"@fr, "Attribute"@en .

<https://w3id.org/PeGazUs#AttributeChange>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#Change> ;
  rdfs:comment "A change on an attribute is a modification applied to an attribute, it defines one or more of its versions that are created or outdated when the change is applied."@en, "Un changement sur un attribut est une modification appliquée à un attribut, elle définit une ou plusieurs de ses versions qui sont créées ou périmées lors de l'application du changement."@fr ;
  rdfs:label "Change on an attribute"@en, "Changement sur l'attribut"@fr .

<https://w3id.org/PeGazUs#AttributeType>
  a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:comment "An attribute type is a category of attributes defined by common characteristics."@en, "Un type d'attribut est une catégorie d'attributs définie par des caractéristiques communes."@fr ;
  rdfs:label "Type d'attribut"@fr, "attribute type"@en .

<https://w3id.org/PeGazUs#AttributeVersion>
  a owl:Class ;
  rdfs:comment "An attribute version is a version of an attribute which has a specific value."@en, "Une version d'attribut est une version reliée à un attribut qui possède est définie par une valeur."@fr ;
  rdfs:label "Attribute version"@en, "Version de l'attribut"@fr .

<https://w3id.org/PeGazUs#Change>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#appliedTo> ;
    owl:allValuesFrom [
      a owl:Class ;
      owl:unionOf (
       <https://w3id.org/PeGazUs#Attribute>
       <https://w3id.org/PeGazUs#Landmark>
       <https://w3id.org/PeGazUs#LandmarkRelation>
     )
    ]
  ] ;
  rdfs:comment "A change is any modification made to a geographic feature or its attributes, or to a relationship between features."@en, "Un changement est toute modification appliquée à une entité géographique ou à ses attributs ou bien à une relation entre entités."@fr ;
  rdfs:label "Change"@en, "Changement"@fr .

<https://w3id.org/PeGazUs#ChangeType>
  a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:comment "A change type is a category of changes defined by common characteristics."@en, "Un type de changement est une catégorie de changements définie par des caractéristiques communes."@fr ;
  rdfs:label "Change Type"@en, "Type de changement"@fr .

<https://w3id.org/PeGazUs#ConstructionGraph>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#Graph> ;
  rdfs:comment "A named graph containing intermediate results produced during the knowledge graph construction process."@en, "Graphe nommé contenant des résultats intermédiaires produits au cours du processus de construction du graphe de connaissances."@fr ;
  rdfs:label "Construction graph"@en, "Graphe de construction"@fr .

<https://w3id.org/PeGazUs#CrispTemporalEntity>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#TemporalEntity> ;
  rdfs:comment "A crisp temporal entity is an entity that has a precise moment in time, which is either an instant or an interval."@en, "Une entité temporelle non floue est une entité qui a un moment précis de temps, que ce soit un instant ou un intervalle."@fr ;
  rdfs:label "Crisp temporal entity"@en, "Entité temporelle non floue"@fr .

<https://w3id.org/PeGazUs#CrispTimeInstant>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#CrispTemporalEntity>, <https://w3id.org/PeGazUs#TimeInstant>, [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#timeCalendar> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass time:TRS
  ], [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#timePrecision> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass time:TemporalUnit
  ], [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#timeStamp> ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:dateTimeStamp
  ] ;
  rdfs:comment "A crisp time instant is a precise moment in time, defined by a timestamp, a calendar, and a temporal precision."@en, "Un instant temporel précis est un moment précis de temps, défini par un stamp, un calendrier et une précision temporelle."@fr ;
  rdfs:label "Crisp time instant"@en, "Instant temporel précis"@fr .

<https://w3id.org/PeGazUs#CrispTimeInterval>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#CrispTemporalEntity>, <https://w3id.org/PeGazUs#TimeInterval> ;
  rdfs:comment "A crisp time interval is a precise time interval, whose bounds are defined by crisp time instants."@en, "Un intervalle temporel précis est un intervalle de temps précis, dont les bornes sont définies par des instants temporels précis."@fr ;
  rdfs:label "Crisp time interval"@en, "Intervalle temporel précis"@fr .

<https://w3id.org/PeGazUs#Event>
  a owl:Class ;
  rdfs:comment "Event describing a development involving one or more resources at a given time."@en, "Un événément décrit une évolution impliquant une ou plusieurs ressources à un instant donné."@fr ;
  rdfs:label "Event"@en, "Événément"@fr .

<https://w3id.org/PeGazUs#FinalAddressSegment>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#AddressSegment>, [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#nextStep> ;
    owl:cardinality "0"^^xsd:nonNegativeInteger
  ] ;
  rdfs:comment "A final address segment is the last segment of an address, it is not followed by any other segment."@en, "Un segment d'adresse final est le dernier segment d'une adresses, elle n'est suivie d'aucun autre segment."@fr ;
  rdfs:label "final Address segment"@en, "segment d'adresse final"@fr .

<https://w3id.org/PeGazUs#FinalGraph>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#Graph> ;
  rdfs:comment "A named graph representing the final, consolidated knowledge graph."@en, "Graphe nommé représentant le graphe de connaissances final et consolidé."@fr ;
  rdfs:label "Final graph"@en, "Graphe final"@fr .

<https://w3id.org/PeGazUs#FuzzyTemporalEntity>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#TemporalEntity> ;
  rdfs:comment "A fuzzy temporal entity is an entity that represents a temporal concept with some degree of uncertainty."@en, "Une entité temporelle floue est une entité qui représente un concept temporel avec une certaine mesure d'incertitude."@fr ;
  rdfs:label "Entité temporelle floue"@fr, "Fuzzy temporal entity"@en .

<https://w3id.org/PeGazUs#FuzzyTimeInstant>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#FuzzyTemporalEntity>, <https://w3id.org/PeGazUs#TimeInstant> ;
  rdfs:comment """
A fuzzy temporal instant represents an instant whose temporal value is uncertain or imprecise. 
This uncertainty may be described using three relations to precise temporal instants: 
- hasFuzzyBeginning indicates the lower bound of the temporal uncertainty;
- hasFuzzyPeak indicates the central or most probable instant;
- hasFuzzyEnd indicates the upper bound of the temporal uncertainty.
These relations are optional and may be used independently of one another depending on the level of precision available in the data.
"""@en, """
Un instant temporel flou représente un instant dont la valeur temporelle est incertaine ou imprécise. 
Cette incertitude peut être décrite à l'aide de trois relations vers des instants temporels précis : 
- hasFuzzyBeginning indique une borne inférieure de l'incertitude temporelle ;
- hasFuzzyPeak indique un instant central ou le plus probable ;
- hasFuzzyEnd indique une borne supérieure de l'incertitude temporelle.
Ces relations sont optionnelles et peuvent être utilisées indépendamment les unes des autres selon le niveau de précision disponible dans les données.
"""@fr ;
  rdfs:label "Fuzzy time instant"@en, "Instant temporel flou"@fr .

<https://w3id.org/PeGazUs#FuzzyTimeInterval>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#FuzzyTemporalEntity>, <https://w3id.org/PeGazUs#TimeInterval> ;
  rdfs:comment "A fuzzy time interval represents an interval whose at least one temporal bound is uncertain or imprecise."@en, "Un intervalle temporel flou représente un intervalle au moins une des bornes temporelles sont incertaines ou imprécises."@fr ;
  rdfs:label "Fuzzy time interval"@en, "Intervalle temporel flou"@fr .

<https://w3id.org/PeGazUs#Graph>
  a owl:Class ;
  rdfs:subClassOf sd:NamedGraph ;
  rdfs:comment "A named graph used as a container for RDF statements."@en, "Graphe nommé utilisé comme conteneur de triplets RDF."@fr ;
  rdfs:label "Graph"@en, "Graphe"@fr .

<https://w3id.org/PeGazUs#Landmark>
  a owl:Class ;
  rdfs:comment "A landmark is a geographic entity. It can be a street, a building, a country, or any other point of reference in space."@en, "Un repère est une entité géographique. Elle peut être une rue, un bâtiment, un pays ou tout autre point de référence dans l'espace."@fr ;
  rdfs:label "Landmark"@en, "Repère"@fr ;
  skos:altLabel "Entité géographique"@fr, "Entité spatiale"@fr, "Geographic entity"@en, "Spatial entity"@en .

<https://w3id.org/PeGazUs#LandmarkChange>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#Change> ;
  rdfs:comment "A change on a landmark is a change of state of a landmark (appearance, disappearance)."@en, "Un changement sur un repère est une modification d'état d'un repère (apparition, disparition)."@fr ;
  rdfs:label "Change on a landmark"@en, "Changement sur le repère"@fr .

<https://w3id.org/PeGazUs#LandmarkRelation>
  a owl:Class ;
  rdfs:comment """Il s'agit d'une relation qui représente un lien existant entre un ou plusieurs repères.
Ces relations peuvent prendre diverses formes, notamment :
- des relations géographiques, par exemple lorsqu'un point de repère est situé à l'angle de deux autres points de repère ;
- des relations hiérarchiques, par exemple lorsqu'un point de repère est la capitale d'une autre entité administrative ;
- d'autres relations spécifiques."""@fr, """It is a relation that represents a relation existing between one or more landmarks.
Such relations may take various forms, including:
- geographic relations, for example when a landmark is located at the corner of two other landmarks;
- hierarchical relations, for example when a landmark is the capital of another administrative entity;
- as well as other domain-specific or contextual relations depending on the application needs.
"""@en ;
  rdfs:label "Landmark relation"@en, "Relation entre repères"@fr .

<https://w3id.org/PeGazUs#LandmarkRelationChange>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#Change> ;
  rdfs:comment "A change on a landmark relation is a change of state of this relation (appearance, disappearance)."@en, "Un changement sur la relation entre repères est une modification d'état de cette relation (apparition, disparition)."@fr ;
  rdfs:label "Change on a landmark relation"@en, "changement sur la relation entre repères"@fr .

<https://w3id.org/PeGazUs#LandmarkRelationType>
  a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:comment "A type of landmark relation is a category that allows classifying the different existing relations between landmarks."@en, "Un type de relation entre repères est une catégorie qui permet de classer les différentes relations existantes des repères."@fr ;
  rdfs:label "Type de relation entre repères"@fr, "type of landmark relation"@en .

<https://w3id.org/PeGazUs#LandmarkType>
  a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:comment "A type of landmark is a category that allows classifying the different types of landmarks."@en, "Un type de repère est une catégorie qui permet de classer les différents types de repères."@fr ;
  rdfs:label "Type de repère"@fr, "Type of landmark"@en .

<https://w3id.org/PeGazUs#LandmarkVersion>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <https://w3id.org/PeGazUs#hasTime> ;
    owl:allValuesFrom <https://w3id.org/PeGazUs#TimeInterval>
  ] ;
  rdfs:comment "A landmark version is a specific instance of a landmark at a given time."@en, "Une version de repère est une instance spécifique d'un repère à un moment donné."@fr ;
  rdfs:label "Landmark version"@en, "Version de repère"@fr .

<https://w3id.org/PeGazUs#SourceGraph>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#Graph> ;
  rdfs:comment "A named graph containing data directly derived from sources."@en, "Graphe nommé contenant des données directement issues de sources."@fr ;
  rdfs:label "Graphe source"@fr, "Source graph"@en .

<https://w3id.org/PeGazUs#TemporalEntity>
  a owl:Class ;
  rdfs:subClassOf time:TemporalEntity ;
  rdfs:comment "A temporal entity is an instance of a temporal concept."@en, "Une entité temporelle est une instance d'un concept temporel."@fr ;
  rdfs:label "Entité temporelle"@fr, "Temporal entity"@en .

<https://w3id.org/PeGazUs#TemporalInstant> a owl:Class .
<https://w3id.org/PeGazUs#TimeInstant>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#TemporalEntity> ;
  rdfs:comment "A time instant is an instance of a temporal entity."@en, "Un instant est une instance d'une entité temporelle."@fr ;
  rdfs:label "Instant"@fr, "Time instant"@en .

<https://w3id.org/PeGazUs#TimeInterval>
  a owl:Class ;
  rdfs:subClassOf <https://w3id.org/PeGazUs#TemporalEntity> ;
  rdfs:comment "A time interval is a period of time."@en, "Un intervalle temporel est une période de temps."@fr ;
  rdfs:label "Intervalle temporel"@fr, "Time interval"@en .

