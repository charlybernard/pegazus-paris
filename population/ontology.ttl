  skos:definition "Change describing the appearance of a landmark relation."@en, "Changement décrivant l'apparition d'une relation entre repères."@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#ChangeList> ;
  skos:prefLabel "Apparition de la relation entre repères"@fr, "Appearance of a landmark relation"@en .

<https://w3id.org/PeGazUs/id/codes/ChangeType/LandmarkRelationDisappearance>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#ChangeType> ;
  skos:definition "Change describing the disappearance of a landmark relation."@en, "Changement décrivant la dissolution d'une relation entre repères."@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#ChangeList> ;
  skos:prefLabel "Disappearance of a landmark relation"@en, "Dissolution de la relation entre repères"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/Along>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:definition "Relation between landmarks defining that the locatum runs alongside the relatum"@en, "Relation entre repères définissant que le locatum longe le relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList> ;
  skos:prefLabel "Along"@en, "Le long de"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/Belongs>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:definition "Relation between landmarks defining that the locatum belongs to the relatum"@en, "Relation entre des repères définissant que le locatum appartient au relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkRelationList> ;
  skos:prefLabel "Appartient à"@fr, "Belongs to"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/Between>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:definition "Relation between landmarks defining that the locatum is between the relatums"@en, "Relation entre repères définissant que le locatum est entre deux relatums"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList> ;
  skos:prefLabel "Between"@en, "Entre"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/Corner>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:definition "Relation between landmarks defining that the locatum is at the corner the relatums"@en, "Relation entre repères définissant que le locatum est au coin du relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList> ;
  skos:prefLabel "Coin"@fr, "Corner"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/EndsAt>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:altLabel "Commence à"@fr ;
  skos:definition "Relation between landmarks defining that the locatum ends at the relatum"@en, "Relation entre repères définissant que le locatum (un repère linéaire) termine au niveau du relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList>, <https://w3id.org/PeGazUs#LandmarkRelationList> ;
  skos:prefLabel "Ends at"@en, "Termine à"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/IsPartOf>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:definition "Relation between landmarks defining that the locatum is part of the relatum"@en, "Relation entre repères définissant que le locatum fait partie du relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList> ;
  skos:prefLabel "Fait partie de"@fr, "Is part of"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/IsSimilar>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:definition "Relation between landmarks defining that the locatum is the same thing as the relatum"@en, "Relation entre repères définissant que le locatum est la même chose que le relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList> ;
  skos:prefLabel "Est similaire à"@fr, "Is similar as"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/StartsAt>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:altLabel "Commence à"@fr ;
  skos:definition "Relation between landmarks defining that the locatum begins at the relatum"@en, "Relation entre repères définissant que le locatum (un repère linéaire) commence au niveau du relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList>, <https://w3id.org/PeGazUs#LandmarkRelationList> ;
  skos:prefLabel "Commence à"@fr, "Starts at"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/Touches>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:altLabel "En contact"@fr, "Limitrophe"@fr ;
  skos:definition "Relation between landmarks defining that the locatum touches the relatum"@en, "Relation entre repères définissant que le locatum est en contact avec le relatum"@fr, "Relation entre repères définissant que le locatum touche le relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList> ;
  skos:prefLabel "Touche"@fr, "Touches"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkRelationType/Within>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkRelationType> ;
  skos:altLabel "À l'intérieur"@fr ;
  skos:definition "Relation between landmarks defining that the locatum is within the relatum"@en, "Relation entre repères définissant que le locatum est situé dans le relatum"@fr, "Relation entre repères entre des repères définissant que le locatum est dans un relatum"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#AdressSegmentList>, <https://w3id.org/PeGazUs#LandmarkRelationList> ;
  skos:prefLabel "Dans"@fr, "Within"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/AdministrativeUnit>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:definition "Area resulting from an administrative division (district, municipality, country...)"@en, "Zone résultant d'un découpage administratif (quatier, commune, pays...)"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "Administrative unit"@en, "Unité administrative"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/Country>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:altLabel "State"@en, "État"@fr ;
  skos:broader <https://w3id.org/PeGazUs/id/codes/LandmarkType/AdministrativeUnity> ;
  skos:definition "Administrative entity describing a state or country"@en, "Entité administrative décrivant un État, un pays"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "Country"@en, "Pays"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/District>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:altLabel "Hameau"@fr, "Neighborhood"@en, "Quarter"@en ;
  skos:broader <https://w3id.org/PeGazUs/id/codes/LandmarkType/AdministrativeUnity> ;
  skos:definition "Administrative entity describing a district"@en, "Entité administrative décrivant un quartier"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "District"@en, "Quartier"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/DistrictNumber>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:broader <https://w3id.org/PeGazUs/id/codes/LandmarkType/HouseNumber> ;
  skos:definition "Numéro d'un bâtiment, d'un immeuble lié à un quartier"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "District number"@en, "Numéro de quartier"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/HouseNumber>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:definition "Number associated with a landmark used to identify a building, a company or a person within the landmark."@en, "Numéro associé à un repère permettant d'identifier un bâtiment, une entreprise, une personne au sein du repère."@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "House number"@en, "Numéro de l'habitation"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/Municipality>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:altLabel "City"@en, "Town"@en, "Ville"@fr ;
  skos:broader <https://w3id.org/PeGazUs/id/codes/LandmarkType/AdministrativeUnity> ;
  skos:definition "Administrative entity describing a city, town or commune"@en, "Entité administrative décrivant une ville, une commune"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "Commune"@fr, "Municipality"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/PostalCodeArea>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:definition "Postal area defined by a code"@en, "Zone postale définie par un code"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "Postal area"@en, "Zone postale"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/StreetNumber>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:broader <https://w3id.org/PeGazUs/id/codes/LandmarkType/HouseNumber> ;
  skos:definition "Number of a building linked to a street"@en, "Numéro d'un bâtiment, d'un immeuble lié à une rue"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "Numéro de rue"@fr, "Street number"@en .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/Structure>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:definition "Defined location (building, shop, house, etc.)"@en, "Lieu défini (bâtiment, magasin, maison...)"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "Structure"@en, "Structure"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/Thoroughfare>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:definition "Any element relating to a thoroughfare (street, square, avenue, etc.)"@en, "Tout élément relatif à une voie de communication (rue, place, avenue...)"@fr ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "Thoroughfare"@en, "Voie"@fr .

<https://w3id.org/PeGazUs/id/codes/LandmarkType/Undefined>
  a owl:NamedIndividual, skos:Concept, <https://w3id.org/PeGazUs#LandmarkType> ;
  skos:definition "Lieu non défini, inconnu"@fr, "Undefined or unknown place"@en ;
  skos:inScheme <https://w3id.org/PeGazUs#LandmarkList> ;
  skos:prefLabel "Non défini"@fr, "Undefined"@en .

[]
  a owl:Axiom ;
  owl:annotatedSource prov:wasRevisionOf ;
  owl:annotatedProperty rdfs:subPropertyOf ;
  owl:annotatedTarget prov:wasDerivedFrom ;
  rdfs:comment """Revision is a derivation (see http://www.w3.org/TR/prov-dm/#term-Revision). Moreover, according to 
http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#term-Revision 23 April 2012 'wasRevisionOf is a strict sub-relation of wasDerivedFrom since two entities e2 and e1 may satisfy wasDerivedFrom(e2,e1) without being a variant of each other.'""" .