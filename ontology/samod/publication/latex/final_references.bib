	author = {Cross, Valerie and Firat, Aykut},
	month = jul,
	year = {2000},
	keywords = {Artificial intelligence, Expert systems, Fuzzy object data model, Geographical information systems, Information storage and retrieval},
	pages = {19--36},
}

