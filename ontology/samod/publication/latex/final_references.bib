@article{morita_cheminement_1980,
	title = {Cheminement et adresse},
	volume = {7},
	copyright = {free},
	url = {https://www.persee.fr/doc/aru_0180-930x_1980_num_7_1_992},
	doi = {10.3406/aru.1980.992},
	abstract = {Dirección y camino. (Takashi Morita, p.27-61) La dirección administrativa define la posición de un punto, lo que representa un mensaje completamente insuficiente para quien quiere encontrarlo por primera vez, en un lugár determinado. La dirección-guía, la direccion-camino, debe proporcionar un ordenamiento lineal que el visitante va a descubrir en el lugar (sucesión de los barrios, de las calles, orientación de la nomenclatura ). El autor propone un esquema analítico de las configuraciones urbanas, distinguiendo tres niveles geográficos : el barrio (nivel zonal), la calle (nivel lineal ), la casa o la puerta (nivel puntual). Siguiendo la combinación de los tres niveles se puedes definir una escala donde las configuraciones urbanas se pueden clasificar en «bien orientables» o «mal orientables». La dirección escrita se presta al mismo tipo de análisis, en función de la descripción más o menos ordenada de los distintos niveles de la configuración urbana que proporciona. Este doble análisis fué aplicado a un centenar de ciudades, lo que hizo posible establecer una tipología, e identificar las condiciones urbanísticas y semiológicas que hacen «eficaz», «confuso» o «desalentador» al sistema de direcciones en una ciudad determinada. Quedan asi planteadas las condiciones de eficacia en la siñalización — complemento al sistema de direcciones. Casi siempre es necesario, en todo caso, recurrir a informaciones complementarias dadas por los habitantes. Por último, el autor adelanta algunas recomendaciones destinadas a los proyectistas de conjuntos urbanos : los planes de vialidad y los planes de urbanización deben concebirse al mismo tiempo que el sistema de direcciones y caminos. Agrega análisis detallados de Nueva York, Tokio, La Défense, Nordweststadt y Matmata.},
	language = {fre},
	number = {1},
	urldate = {2023-04-03},
	journal = {Les Annales de la Recherche Urbaine},
	author = {Morita, Takashi},
	year = {1980},
	note = {Publisher: Persée - Portail des revues scientifiques en SHS},
	pages = {27--61},
}

@article{motik_representing_nodate,
	title = {Representing and {Querying} {Validity} {Time} in {RDF} and {OWL}: {A} {Logic}-{Based} {Approach}},
	abstract = {RDF(S) and OWL 2 currently support only static ontologies. In practice, however, the truth of statements often changes with time, and Semantic Web applications often need to represent such changes and reason about them. In this paper we present a logic-based approach for representing validity time in RDF and OWL. Unlike the existing proposals, our approach is applicable to entailment relations that are not deterministic, such as the Direct Semantics or the RDF-Based Semantics of OWL 2. We also extend SPARQL to temporal RDF graphs and present a query evaluation algorithm. Finally, we present an optimization of our algorithm that is applicable to entailment relations characterized by a set of deterministic rules, such RDF(S) and OWL 2 RL/RDF entailment.},
	language = {en},
	author = {Motik, Boris},
}

@article{zhang_temporal_2019,
	title = {Temporal {Data} {Representation} and {Querying} {Based} on {RDF}},
	volume = {7},
	issn = {2169-3536},
	doi = {10.1109/ACCESS.2019.2924550},
	abstract = {With the explosive growth of temporal data, how to query and manage temporal data has become an important research issue. Resource description framework (RDF), as the standard data and knowledge description language of the semantic web, has been widely used to represent various domain data. Aiming at the representation and querying of temporal data, this paper proposes a temporal data representation model based on RDF and its corresponding querying method. First, a representation model called RDFt is proposed, which can represent temporal data with both the time information and the update count information, and the syntax and semantics of the RDFt model are given. Then, we propose a query language called SPARQL[t] for RDFt, and we give the query syntax and operations of SPARQL[t] in detail. In addition, a querying transformation algorithm from SPARQL[t] to SPARQL is proposed, in order to achieve compatibility with the existing RDF query engines. Finally, we implemented a prototype system that can support RDFt temporal data representation and querying, and the case studies and experimental results verify the feasibility of the proposed approach.},
	journal = {IEEE Access},
	author = {Zhang, Fu and Wang, Ke and Li, Zhiyin and Cheng, Jingwei},
	year = {2019},
	note = {Conference Name: IEEE Access},
	keywords = {Data models, Database languages, Databases, Prototypes, RDF, Resource description framework, SPARQL, Semantics, Syntactics, Temporal data, querying, representation},
	pages = {85000--85023},
}

